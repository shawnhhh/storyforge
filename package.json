{
  "name": "storyforge",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "npm run typecheck && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "dev:all": "concurrently -k -n web,server \"npm run dev\" \"npm run dev:server\"",
    "dev:server": "tsx watch --env-file-if-exists=.env server/src/index.ts",
    "start:server": "tsx --env-file-if-exists=.env server/src/index.ts",
    "typecheck": "tsc -b && tsc -p server/tsconfig.json && tsc -p tests/e2e/tsconfig.json && tsc -p tests/unit/tsconfig.json",
    "test": "node --import tsx --test server/tests/*.test.ts tests/unit/*.test.ts",
    "test:e2e": "node --import tsx tests/e2e/run.ts"
  },
  "dependencies": {
    "@tiptap/core": "^3.32.0",
    "@tiptap/pm": "^3.32.0",
    "@tiptap/react": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "express": "^5.3.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/express": "^5.0.6",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.6",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.12.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.3.0"
  },
  "engines": {
    "node": ">=24.0.0 <25"
  }
}
