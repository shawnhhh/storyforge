# Copy to .env for local overrides. Never store secrets in VITE_* variables.
SERVER_PORT=3001
STORYFORGE_DATA_DIR=./data
# Optional absolute path OUTSIDE the project. Mac default:
# ~/Library/Application Support/StoryForge/Backups (expanded by the app).
# STORYFORGE_BACKUP_DIR=/Users/your-name/Library/Application Support/StoryForge/Backups

# Optional AI writing: server-side only. Keep .env private (chmod 600 .env).
# Leave the key empty to disable AI; all other features remain available.
STORYFORGE_AI_API_KEY=
STORYFORGE_AI_BASE_URL=https://api.openai.com/v1
STORYFORGE_AI_MODEL=gpt-4o-mini
STORYFORGE_AI_TIMEOUT_MS=60000

# Optional additional provider. Keys stay in this ignored server-side file.
STORYFORGE_DEEPSEEK_API_KEY=
STORYFORGE_DEEPSEEK_MODEL=deepseek-chat
STORYFORGE_DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# Optional catalog JSON uses keyEnv NAMES, never inline key values; see docs/ai-workbench.md.
# STORYFORGE_AI_MODELS_JSON=[{"id":"local","label":"Local","provider":"compatible","model":"local-model","baseUrl":"http://127.0.0.1:1234/v1","keyEnv":"STORYFORGE_LOCAL_API_KEY","maxOutputTokens":1024}]
# Conservative per-process reservations, including cancelled/failed requests.
STORYFORGE_AI_REQUESTS_PER_MINUTE=20
STORYFORGE_AI_SESSION_REQUESTS=100
STORYFORGE_AI_SESSION_TOKENS=200000
STORYFORGE_AI_MAX_INPUT_TOKENS=64000
STORYFORGE_AI_MAX_REQUEST_USD=1
STORYFORGE_AI_SESSION_USD=5
